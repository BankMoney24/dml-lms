# Apache / LiteSpeed. Nginx servers use deploy/nginx/dml-lms.conf instead.
# HTTP→HTTPS redirects live in the virtual host (deploy/apache/), not here.
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Only the front controller runs; refuse dotfiles and any other PHP file.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

<IfModule mod_headers.c>
    # Styles and scripts are linked with ?v=<release>, so they can be cached for a year.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # The service worker has no version in its address: browsers must always check it.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Compress text for slow connections (pages, styles, scripts, sitemaps, the icon sprite).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/calendar application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
