# Copy to shared/.env on the server (chmod 640). Never commit a real .env.
APP_ENV=production
APP_DEBUG=false
# 32+ random characters, e.g. from: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=
# Hosts that show the platform page instead of a tenant (comma-separated). Leave empty if every host is a tenant.
PLATFORM_HOSTS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dml_lms
DB_USERNAME=dml_lms
DB_PASSWORD=
# Optional: connect through a Unix socket instead of host/port (e.g. /var/lib/mysql/mysql.sock).
DB_SOCKET=

SESSION_SECURE_COOKIE=true

# The school's canonical address (ADR 0019). deploy/server/setup-domain.sh sets these once HTTPS works.
# PUBLIC_SCHEME: https once the domain has a certificate; empty = whatever the request used.
PUBLIC_SCHEME=
# true: page views on an alias (www., the server IP, plain HTTP) are sent to the primary domain with a 301.
CANONICAL_REDIRECT=false
# Strict-Transport-Security on HTTPS responses: seconds (0 = off). Subdomains only if every one serves HTTPS.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
SESSION_IDLE_SECONDS=7200
# Defaults to <release>/storage, which the deploy script links to shared/storage.
STORAGE_PATH=

# Email. Without MAIL_DRIVER=smtp in production, nothing is emailed: admins see
# a one-time password when adding people, and "Forgotten password" tells users
# to ask an administrator. Values: smtp | disabled (| file outside production).
MAIL_DRIVER=disabled
MAIL_HOST=
# 587 with tls (STARTTLS), 465 with ssl, 25 with none (local relay only).
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=15
# Must be an address your provider lets you send from (SPF/DKIM for the domain).
MAIL_FROM_ADDRESS=no-reply@dmlschooloftechnology.org
MAIL_FROM_NAME="DML School of Technology"

# Roles that must use two-step sign-in (authenticator app). Empty = nobody is forced.
TWO_FACTOR_REQUIRED_ROLES=owner,admin

# Uploads (lesson files, assignment files). Stored in STORAGE_PATH/uploads,
# outside the web root; back that folder up with the database.
UPLOAD_MAX_MB=10
# Video and audio (lesson media, class recordings). PHP's upload_max_filesize
# and post_max_size, Apache's LimitRequestBody and, with ClamAV, clamd's
# StreamMaxLength must all allow this size too (docs/deployment.md).
MEDIA_MAX_MB=200
UPLOAD_TENANT_QUOTA_MB=5120
# Set to clamd to scan every upload with ClamAV (refused if clamd is down).
UPLOAD_SCANNER=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
