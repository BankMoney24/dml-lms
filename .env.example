# Copy to shared/.env on the server (chmod 640). Never commit a real .env.
APP_ENV=production
APP_DEBUG=false
# 32+ random characters, e.g. from: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=
# Hosts that show the platform page instead of a tenant (comma-separated). Leave empty if every host is a tenant.
PLATFORM_HOSTS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dml_lms
DB_USERNAME=dml_lms
DB_PASSWORD=

SESSION_SECURE_COOKIE=true
SESSION_IDLE_SECONDS=7200
# Defaults to <release>/storage, which the deploy script links to shared/storage.
STORAGE_PATH=
