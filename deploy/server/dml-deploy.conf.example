# Copy to ~/.dml-deploy.conf of the deploy user (chmod 600).
# One deploy user per environment, e.g. dmldeploy (production), dmlstaging (staging).

APP_ROOT=/var/www/dml-lms            # cPanel: /home/<account>/dml-lms
HEALTH_HOST=dmlschooloftechnology.com # the host the health check is sent to
HEALTH_SCHEME=https
HEALTH_PORT=443
PHP_BIN=php                          # cPanel: /opt/cpanel/ea-php83/root/usr/bin/php
KEEP_RELEASES=5
DB_NAME=dml_lms                      # used for the pre-migration backup (credentials in ~/.my.cnf)

# Optional: reload PHP-FPM so OPcache drops the old release path.
# Needs a sudoers rule allowing exactly this command, nothing else.
RELOAD_CMD=""
